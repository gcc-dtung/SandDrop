root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,asmdef,asmref,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

# Formatting (Allman braces, as in Unity templates)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
dotnet_sort_system_directives_first = true

# Style: preferences, shown as suggestions
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
dotnet_style_readonly_field = true:suggestion

# ---- Naming (GameKit code only; third-party folders keep their own style) ----
[Assets/_Project/**.cs]

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, private_protected
dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public, internal
dotnet_naming_symbols.locals.applicable_kinds = parameter, local

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I

# Order matters: the first matching rule wins.
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_rule.types_are_pascal.symbols = types
dotnet_naming_rule.types_are_pascal.style = pascal
dotnet_naming_rule.types_are_pascal.severity = warning

dotnet_naming_rule.members_are_pascal.symbols = members
dotnet_naming_rule.members_are_pascal.style = pascal
dotnet_naming_rule.members_are_pascal.severity = warning

dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning

# Private fields: camelCase, no underscore ([SerializeField] private float fadeDuration).
dotnet_naming_rule.private_fields_are_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel.style = camel
dotnet_naming_rule.private_fields_are_camel.severity = warning

# Public fields only on serialized data classes (save data, configs): camelCase like Unity's own.
dotnet_naming_rule.public_fields_are_camel.symbols = public_fields
dotnet_naming_rule.public_fields_are_camel.style = camel
dotnet_naming_rule.public_fields_are_camel.severity = suggestion

dotnet_naming_rule.locals_are_camel.symbols = locals
dotnet_naming_rule.locals_are_camel.style = camel
dotnet_naming_rule.locals_are_camel.severity = warning
